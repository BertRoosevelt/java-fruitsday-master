<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE web-app PUBLIC
        "-//Sun Microsystems, Inc.//DTD Web Application 2.3//EN"
        "http://java.sun.com/dtd/web-app_2_3.dtd" >

<web-app>
    <display-name>FruitDay - Online Supermarket</display-name>

    <!-- Servlet 定义 -->
    <servlet>
        <servlet-name>fruitServlet</servlet-name>
        <servlet-class>com.fruitDayDB.servlet.FruitServlet</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>shopServlet</servlet-name>
        <servlet-class>com.fruitDayDB.servlet.ShopServlet</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>userServlet</servlet-name>
        <servlet-class>com.fruitDayDB.servlet.UserServlet</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>orderServlet</servlet-name>
        <servlet-class>com.fruitDayDB.servlet.OrderServlet</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>selServlet</servlet-name>
        <servlet-class>com.fruitDayDB.servlet.selServlet</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>bsServlet</servlet-name>
        <servlet-class>com.fruitDayDB.servlet.BSServlet</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>adminServlet</servlet-name>
        <servlet-class>com.fruitDayDB.servlet.AdminServlet</servlet-class>
    </servlet>

    <!-- Servlet 映射 -->
    <servlet-mapping>
        <servlet-name>fruitServlet</servlet-name>
        <url-pattern>/FruitServlet</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>shopServlet</servlet-name>
        <url-pattern>/ShopServlet</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>userServlet</servlet-name>
        <url-pattern>/UserServlet</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>orderServlet</servlet-name>
        <url-pattern>/OrderServlet</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>selServlet</servlet-name>
        <url-pattern>/SELServlet</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>bsServlet</servlet-name>
        <url-pattern>/BSServlet</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>adminServlet</servlet-name>
        <url-pattern>/AdminServlet</url-pattern>
    </servlet-mapping>

</web-app>